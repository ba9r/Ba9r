-- HITBOX NGƯỜI CHƠI (ĐỎ)
local function applyHitbox(character)
local hrp=character:FindFirstChild("HumanoidRootPart")
if not hrp then return end
if not origHitboxData[hrp] then
origHitboxData[hrp]={Size=hrp.Size,Transparency=hrp.Transparency,Color=hrp.Color,Material=hrp.Material,CanCollide=hrp.CanCollide}
end
hrp.Size=Vector3.new(hbSize,hbSize,hbSize)
hrp.Transparency=hbTrans
hrp.Color=Color3.fromRGB(255,0,0)
hrp.Material=Enum.Material.Neon
hrp.CanCollide=false
end
local function removeHitbox(character)
local hrp=character:FindFirstChild("HumanoidRootPart")
if not hrp then return end
local orig=origHitboxData[hrp]
if orig then
hrp.Size=orig.Size
hrp.Transparency=orig.Transparency
hrp.Color=orig.Color
hrp.Material=orig.Material
hrp.CanCollide=orig.CanCollide
origHitboxData[hrp]=nil
end
end
local function restoreAllHitbox()
for _,p in ipairs(game.Players:GetPlayers()) do
if p~=LP and p.Character then removeHitbox(p.Character) end
end
origHitboxData={}
end

-- HITBOX NPC (XANH LÁ)
local function applyHitboxNPC(character)
local hrp=character:FindFirstChild("HumanoidRootPart")
if not hrp then
hrp=character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
end
if not hrp then return end
if not origHitboxNPC[hrp] then
origHitboxNPC[hrp]={Size=hrp.Size,Transparency=hrp.Transparency,Color=hrp.Color,Material=hrp.Material,CanCollide=hrp.CanCollide}
end
hrp.Size=Vector3.new(hbSizeN,hbSizeN,hbSizeN)
hrp.Transparency=hbTransN
hrp.Color=Color3.fromRGB(0,255,0)
hrp.Material=Enum.Material.Neon
hrp.CanCollide=false
end
local function removeHitboxNPC(character)
local hrp=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
if not hrp then return end
