local function getRootPart(char)
return char and char:FindFirstChild("HumanoidRootPart")
end
local function clrE(p)
if ec[p] then pcall(function() ec[p].B:Remove();ec[p].G:Remove();ec[p].H:Remove() end);ec[p]=nil end
end
local function clrAll()
for p,_ in pairs(ec) do clrE(p) end
end
local function vis(p,cm)
local rp=RaycastParams.new()
rp.FilterType=Enum.RaycastFilterType.Exclude
rp.FilterDescendantsInstances={LP.Character,cm}
local r=WS:Raycast(cm.CFrame.Position,p.Position-cm.CFrame.Position,rp)
return r and (r.Instance==p or r.Instance:IsDescendantOf(p.Parent)) or false
end
